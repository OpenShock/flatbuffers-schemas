include "./Common/ShockerCommand.fbs";

attribute "fs_serializer";

namespace OpenShock.Serialization.Local;

enum LedPreviewPattern : uint8 {
  WifiDisconnected = 0,
  WifiScanning = 1,
  NoBackend = 2,
  Connected = 3,
  EStopped = 4,
  EStopClearing = 5,
  EStopAwaitingRelease = 6,
  CriticalError = 7
}

enum LedTarget : uint8 {
  All = 0,
  Mono = 1,
  Rgb = 2
}

/// Shows a state's pattern on the status LEDs whatever the LED mode, at the saved brightness. Nothing is saved.
table LedPreviewPatternMessage {
  pattern:LedPreviewPattern;
}

/// Shows a solid color on the status LEDs: the RGB LED in the color, the mono LED on unless it is black.
/// Sent at a high rate while the user drags a color or brightness control. Nothing is saved.
table LedPreviewColorMessage {
  /// RGB10 packed: red in bits 20-29, green in bits 10-19, blue in bits 0-9 (0-1023 each), bits 30-31 zero. The hub
  /// dithers the RGB LED, so it shows more than the LED's 8 bits.
  color_rgb10:uint32;
  /// The LED to light; the other stays dark. A target the board doesn't have lights nothing.
  target:LedTarget;
  /// 16-bit brightness (0-65535) for this preview only; null is each LED's saved normal brightness.
  brightness:uint16 = null;
}

/// Ends a preview early.
table LedPreviewStopMessage {}

union LocalToHubMessagePayload {
  Common.ShockerCommandList,
  LedPreviewPatternMessage,
  LedPreviewColorMessage,
  LedPreviewStopMessage,
}

table LocalToHubMessage (fs_serializer) {
  payload:LocalToHubMessagePayload;
}

root_type LocalToHubMessage;
